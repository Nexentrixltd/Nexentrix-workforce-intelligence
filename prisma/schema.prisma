generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EXECUTIVE
  CHIEF_OF_STAFF
  ARM_HEAD
  HR
  TEAM_LEAD
  STAFF
}

enum DepartmentStatus {
  ACTIVE
  PLANNED
}

enum ReportStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(STAFF)
  image         String?
  emailVerified DateTime?
  isFirstLogin  Boolean   @default(true)
  remember      Boolean   @default(false)
  lastLoginAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  ledDepartments Department[] @relation("DepartmentLead")
  headOfArm      Arm?         @relation("ArmHead")

  ledProjects    Project[]       @relation("ProjectLead")
  projectMembers ProjectMember[]

  sessions    Session[]
  loginEvents LoginEvent[]

  notifications Notification[] @relation("NotificationRecipient")

  reports         Report[] @relation("ReportAuthor")
  reviewedReports Report[] @relation("ReportReviewer")
  reminderEnabled Boolean @default(true)

  @@index([departmentId])
  @@index([role, deactivatedAt])
}

model Arm {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  isShared    Boolean      @default(false)
  headId      String?      @unique
  head        User?        @relation("ArmHead", fields: [headId], references: [id], onDelete: SetNull)
  departments Department[]
  createdAt   DateTime     @default(now())
}

model Department {
  id         String           @id @default(cuid())
  name       String           @unique
  slug       String           @unique
  focus      String?
  status     DepartmentStatus @default(PLANNED)
  armId      String
  arm        Arm              @relation(fields: [armId], references: [id], onDelete: Restrict)
  teamLeadId String?
  teamLead   User?            @relation("DepartmentLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  members    User[]           @relation("DepartmentMembers")
  projects   Project[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  reports    Report[]

  @@index([armId])
  @@index([teamLeadId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id           String          @id @default(cuid())
  name         String
  code         String          @unique
  description  String?
  status       ProjectStatus   @default(PLANNING)
  startDate    DateTime?
  endDate      DateTime?
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadId       String
  lead         User            @relation("ProjectLead", fields: [leadId], references: [id])
  members      ProjectMember[]
  reports      Report[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ProjectMember {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  roleOnProject String?
  allocation    Int?
  joinedAt      DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Report {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  departmentId     String?
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reportDate       DateTime      @db.Date
  tasksCompleted   String
  tasksInProgress  String?
  blockers         String?
  tomorrowPriority String?
  hoursSpent       Float
  mood             Int
  status           ReportStatus  @default(SUBMITTED)
  reviewedById     String?
  reviewedBy       User?         @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  images           ReportImage[]
  reviewNote       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([userId, projectId, reportDate])
  @@index([status])
}

model ReportImage {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  publicId  String   @unique
  format    String
  bytes     Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@index([reportId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EXECUTIVE
  CHIEF_OF_STAFF
  ARM_HEAD
  HR
  TEAM_LEAD
  STAFF
}

enum DepartmentStatus {
  ACTIVE
  PLANNED
}

enum ReportStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(STAFF)
  image         String?
  emailVerified DateTime?
  isFirstLogin  Boolean   @default(true)
  remember      Boolean   @default(false)
  lastLoginAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  ledDepartments Department[] @relation("DepartmentLead")
  headOfArm      Arm?         @relation("ArmHead")

  ledProjects    Project[]       @relation("ProjectLead")
  projectMembers ProjectMember[]

  sessions    Session[]
  loginEvents LoginEvent[]

  notifications      Notification[]     @relation("NotificationRecipient")
  mutedNotifications String[]           @default([])
  PushSubscription   PushSubscription[] @relation("PushSub")

  reports           Report[]           @relation("ReportAuthor")
  reviewedReports   Report[]           @relation("ReportReviewer")
  reminderEnabled   Boolean            @default(true)
  staffProfile      StaffProfile?
  payroll           PayrollDetail?
  staffDocuments    StaffDocument[]
  signatory         SignatoryDetail?
  emergencyContacts EmergencyContact[]

  @@index([departmentId])
  @@index([role, deactivatedAt])
}

model Arm {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  isShared    Boolean      @default(false)
  headId      String?      @unique
  head        User?        @relation("ArmHead", fields: [headId], references: [id], onDelete: SetNull)
  departments Department[]
  createdAt   DateTime     @default(now())
}

model Department {
  id         String           @id @default(cuid())
  name       String           @unique
  slug       String           @unique
  focus      String?
  status     DepartmentStatus @default(PLANNED)
  armId      String
  arm        Arm              @relation(fields: [armId], references: [id], onDelete: Restrict)
  teamLeadId String?
  teamLead   User?            @relation("DepartmentLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  members    User[]           @relation("DepartmentMembers")
  projects   Project[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  reports    Report[]

  @@index([armId])
  @@index([teamLeadId])
}

model Session {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  lastSeenAt DateTime    @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  loginEvent LoginEvent?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  sessionId String?  @unique
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id           String          @id @default(cuid())
  name         String
  code         String          @unique
  description  String?
  status       ProjectStatus   @default(PLANNING)
  startDate    DateTime?
  endDate      DateTime?
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadId       String
  lead         User            @relation("ProjectLead", fields: [leadId], references: [id])
  members      ProjectMember[]
  reports      Report[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ProjectMember {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  roleOnProject String?
  allocation    Int?
  joinedAt      DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Report {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  departmentId     String?
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reportDate       DateTime      @db.Date
  tasksCompleted   String
  tasksInProgress  String?
  blockers         String?
  tomorrowPriority String?
  hoursSpent       Float
  mood             Int
  status           ReportStatus  @default(SUBMITTED)
  reviewedById     String?
  reviewedBy       User?         @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  images           ReportImage[]
  reviewNote       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([userId, projectId, reportDate])
  @@index([status])
}

model ReportImage {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  publicId  String   @unique
  format    String
  bytes     Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@index([reportId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation("PushSub", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DetailStatus {
  PENDING
  VERIFIED
  REJECTED
}

model StaffProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferredName String?
  phone         String?
  altPhone      String?
  personalEmail String?
  addressLine   String?
  city          String?
  state         String?
  country       String?
  dateOfBirth   DateTime? @db.Date
  gender        String?
  maritalStatus String?
  nationality   String?
  stateOfOrigin String?
  photoKey      String?

  status       DetailStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

model EmergencyContact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  relationship String
  phone        String
  altPhone     String?
  address      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model PayrollDetail {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankName         String
  accountName      String
  accountNumberEnc String
  accountLast4     String
  taxIdEnc         String?
  pensionNumberEnc String?

  status       DetailStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

model SignatoryDetail {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  signatoryName String
  title         String?
  signatureKey  String

  status       DetailStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

model SensitiveAccessLog {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String
  field        String
  reason       String?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

enum DocumentType {
  PASSPORT_PHOTO
  APPOINTMENT_LETTER
  EDUCATION_CERTIFICATE
  NATIONAL_ID
  DEFERRED_PAYMENT_FORM
  EMPLOYEE_HANDBOOK
  CV
  OTHER
}

model StaffDocument {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      DocumentType
  title     String?
  fileKey   String
  fileName  String
  mimeType  String
  sizeBytes Int

  status       DetailStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, type])
  @@index([status])
}
